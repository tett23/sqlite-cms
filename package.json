{
  "name": "sqlite-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:db": "cargo run --quiet --release --manifest-path cli/Cargo.toml -- \"${SITE_DIR:-example}\"",
    "dev": "npm run build:db && vite",
    "build": "npm run build:db && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:db": "cargo test --quiet --manifest-path cli/Cargo.toml",
    "test": "npm run test:db && vitest run",
    "deploy": "test -n \"$SITE_DIR\" || { echo \"deploy: SITE_DIR に記事リポジトリのディレクトリを指定してください\" >&2; exit 1; } && npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.30.0"
  }
}
