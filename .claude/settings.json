{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-adr-immutable.sh\"",
            "timeout": 10,
            "statusMessage": "コミット済みの ADR の変更を確かめています"
          }
        ]
      }
    ]
  }
}
