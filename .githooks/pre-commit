#!/bin/sh
# git の pre-commit フック。コミット済みの ADR を、ステータスの行のほかで書き換え、消し、名前を変えるコミットと、文書のリンクのない ADR の参照を adr-guard で止める（ADR 0064、0068）。
# ADR の参照のリンクだけを変える書き換えは許す（--allow-links）。
# 有効にするには、adr-guard を入れ、リポジトリで一度 `git config core.hooksPath .githooks` を実行する（DEVELOPMENT.md の「ADR」）。
exec adr-guard pre-commit --allow-links
