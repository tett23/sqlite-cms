#!/bin/sh
# git の pre-commit フック。コミット済みの ADR を書き換え、消し、名前を変えるコミットを止める。
# 「状態」の節だけの変更と、新しい ADR を足すのはよい（DEVELOPMENT.md の「ADR」）。
# 有効にするには、リポジトリで一度 `git config core.hooksPath .githooks` を実行する。
set -u

if ! violations=$(sh "$(dirname "$0")/check-adr.sh" --staged 2>&1); then
  {
    echo "pre-commit: コミット済みの ADR は、状態の節のほかは書き換えません。次の変更をコミットできません。"
    echo "$violations"
    echo "変更を取り消し（git restore --source=HEAD --staged --worktree -- <ファイル>）、"
    echo "判断を改めるときは、次の番号で新しい ADR を書いてください。"
  } >&2
  exit 1
fi
